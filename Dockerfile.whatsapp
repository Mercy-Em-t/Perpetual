FROM node:20-alpine

WORKDIR /app

# Install system utilities for healthchecks
RUN apk add --no-cache curl

# Copy gateway package metadata
COPY whatsapp_gateway/package.json ./package.json

# Install production dependencies
RUN npm install --production

# Copy gateway source & shop manifests/catalogs
COPY whatsapp_gateway/ ./whatsapp_gateway/
COPY config/ ./config/

EXPOSE 5174

ENV NODE_ENV=production
ENV WHATSAPP_PORT=5174
ENV WHATSAPP_AUTH_DIR=/app/.auth_whatsapp_baileys

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://127.0.0.1:5174/health || exit 1

CMD ["node", "whatsapp_gateway/index.mjs"]
